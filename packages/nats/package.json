{
  "name": "@openstatus/health-nats",
  "version": "0.1.4",
  "description": "NATS probe for @openstatus/health",
  "keywords": [
    "health",
    "healthcheck",
    "jetstream",
    "messaging",
    "nats",
    "openstatus",
    "pubsub"
  ],
  "homepage": "https://github.com/openstatusHQ/health",
  "bugs": {
    "url": "https://github.com/openstatusHQ/health/issues"
  },
  "license": "MIT",
  "author": {
    "name": "openstatus",
    "url": "https://www.openstatus.dev/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openstatusHQ/health.git",
    "directory": "packages/nats/"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/mod.cjs",
  "module": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/mod.d.ts",
        "require": "./dist/mod.d.cts"
      },
      "import": "./dist/mod.js",
      "require": "./dist/mod.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp pack"
  },
  "devDependencies": {
    "@openstatus/health": "workspace:*"
  },
  "peerDependencies": {
    "@nats-io/nats-core": ">=3.0.0",
    "@openstatus/health": "^0.1.4",
    "nats": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@nats-io/nats-core": {
      "optional": true
    },
    "nats": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
