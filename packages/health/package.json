{
  "name": "@openstatus/health",
  "version": "0.1.4",
  "description": "Framework-agnostic health endpoint core: probes, caching, response rendering",
  "keywords": [
    "health",
    "healthcheck",
    "liveness",
    "openstatus",
    "probe",
    "readiness"
  ],
  "homepage": "https://github.com/openstatusHQ/health",
  "bugs": {
    "url": "https://github.com/openstatusHQ/health/issues"
  },
  "license": "MIT",
  "author": {
    "name": "openstatus",
    "url": "https://www.openstatus.dev/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openstatusHQ/health.git",
    "directory": "packages/health/"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/mod.cjs",
  "module": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/mod.d.ts",
        "require": "./dist/mod.d.cts"
      },
      "import": "./dist/mod.js",
      "require": "./dist/mod.cjs"
    },
    "./testing": {
      "types": {
        "import": "./dist/testing.d.ts",
        "require": "./dist/testing.d.cts"
      },
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp pack"
  },
  "engines": {
    "node": ">=22"
  }
}
