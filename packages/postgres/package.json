{
  "name": "@openstatus/health-postgres",
  "version": "0.1.4",
  "description": "Postgres probe for @openstatus/health",
  "keywords": [
    "database",
    "health",
    "healthcheck",
    "openstatus",
    "pg",
    "postgres",
    "postgresql"
  ],
  "homepage": "https://github.com/openstatusHQ/health",
  "bugs": {
    "url": "https://github.com/openstatusHQ/health/issues"
  },
  "license": "MIT",
  "author": {
    "name": "openstatus",
    "url": "https://www.openstatus.dev/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openstatusHQ/health.git",
    "directory": "packages/postgres/"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/mod.cjs",
  "module": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/mod.d.ts",
        "require": "./dist/mod.d.cts"
      },
      "import": "./dist/mod.js",
      "require": "./dist/mod.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp pack"
  },
  "devDependencies": {
    "@openstatus/health": "workspace:*",
    "@types/pg": "^8.15.0",
    "pg": "^8.16.0",
    "postgres": "^3.4.0"
  },
  "peerDependencies": {
    "@openstatus/health": "^0.1.4",
    "pg": ">=8.0.0",
    "postgres": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
