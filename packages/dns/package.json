{
  "name": "@openstatus/health-dns",
  "version": "0.1.4",
  "description": "DNS lookup probe for @openstatus/health",
  "keywords": [
    "dns",
    "health",
    "healthcheck",
    "lookup",
    "network",
    "openstatus"
  ],
  "homepage": "https://github.com/openstatusHQ/health",
  "bugs": {
    "url": "https://github.com/openstatusHQ/health/issues"
  },
  "license": "MIT",
  "author": {
    "name": "openstatus",
    "url": "https://www.openstatus.dev/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openstatusHQ/health.git",
    "directory": "packages/dns/"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/mod.cjs",
  "module": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/mod.d.ts",
        "require": "./dist/mod.d.cts"
      },
      "import": "./dist/mod.js",
      "require": "./dist/mod.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp pack"
  },
  "devDependencies": {
    "@openstatus/health": "workspace:*",
    "@types/node": ">=22"
  },
  "peerDependencies": {
    "@openstatus/health": "^0.1.4"
  },
  "engines": {
    "node": ">=22"
  }
}
