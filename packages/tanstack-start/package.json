{
  "name": "@openstatus/health-tanstack-start",
  "version": "0.1.4",
  "description": "TanStack Start adapter for @openstatus/health",
  "keywords": [
    "health",
    "healthcheck",
    "openstatus",
    "server-routes",
    "tanstack",
    "tanstack-start"
  ],
  "homepage": "https://github.com/openstatusHQ/health",
  "bugs": {
    "url": "https://github.com/openstatusHQ/health/issues"
  },
  "license": "MIT",
  "author": {
    "name": "openstatus",
    "url": "https://www.openstatus.dev/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openstatusHQ/health.git",
    "directory": "packages/tanstack-start/"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/mod.cjs",
  "module": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/mod.d.ts",
        "require": "./dist/mod.d.cts"
      },
      "import": "./dist/mod.js",
      "require": "./dist/mod.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp pack"
  },
  "devDependencies": {
    "@openstatus/health": "workspace:*",
    "@tanstack/react-router": "^1.170.35",
    "@tanstack/start-client-core": "^1.170.29"
  },
  "peerDependencies": {
    "@openstatus/health": "^0.1.4"
  },
  "engines": {
    "node": ">=22"
  }
}
