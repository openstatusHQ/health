{
  "name": "@openstatus/health-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "check:treeshake": "vp run -r build && node scripts/check_treeshake.ts",
    "check:versions": "node scripts/check_versions.ts",
    "test:dist": "vp run -r build && vp test --mode dist",
    "update-versions": "node scripts/update_versions.ts",
    "test-all": "vp check && vp run check:versions && vp test && vp run test:dist && vp run check:treeshake"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.27.0",
    "typescript": "^5.8.3",
    "vite-plus": "1.1.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.10.1"
}
