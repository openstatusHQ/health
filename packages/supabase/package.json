{
  "name": "@openstatus/health-supabase",
  "version": "0.1.4",
  "description": "Supabase connection-pressure probe for @openstatus/health",
  "keywords": [
    "health",
    "healthcheck",
    "openstatus",
    "postgres",
    "supabase"
  ],
  "homepage": "https://github.com/openstatusHQ/health",
  "bugs": {
    "url": "https://github.com/openstatusHQ/health/issues"
  },
  "license": "MIT",
  "author": {
    "name": "openstatus",
    "url": "https://www.openstatus.dev/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openstatusHQ/health.git",
    "directory": "packages/supabase/"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/mod.cjs",
  "module": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/mod.d.ts",
        "require": "./dist/mod.d.cts"
      },
      "import": "./dist/mod.js",
      "require": "./dist/mod.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp pack"
  },
  "devDependencies": {
    "@openstatus/health": "workspace:*",
    "@supabase/supabase-js": "^2.0.0"
  },
  "peerDependencies": {
    "@openstatus/health": "^0.1.4",
    "@supabase/supabase-js": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
